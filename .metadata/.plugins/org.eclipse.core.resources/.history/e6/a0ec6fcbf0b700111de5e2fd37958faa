package com.titan.notification.processor;

import org.springframework.stereotype.Service;

import com.titan.notification.event.OrderCreatedEvent;

@Service
public class SMSNotificationProcessor implements NotificationProcessor {

	@Override
	public void sendNotification(OrderCreatedEvent event, String eventName) {
		System.out.println(eventName + " Confirmation for Order : " + event.getOrderNo() + " Sent to Mobile : "
				+ event.getEmail());
	}

}
