package com.titan.notification.service;

import java.util.List;

import com.titan.notification.event.OrderCreatedEvent;
import com.titan.notification.processor.NotificationProcessor;
import com.titan.notification.repository.NotificationProcessedEventRepository;
import com.titan.notification.response.NotificationResponse;
import com.titan.payment.event.PaymentCreatedEvent;
import com.titan.payment.event.PaymentProcessEvent;
import com.titan.payment.processor.PaymentProcessor;
import com.titan.payment.response.PaymentResponse;

public class NotificationService {

	private final List<NotificationProcessor> processors;
	private final NotificationProcessedEventRepository notificationProcessedEventRepository;

	public NotificationService(List<NotificationProcessor> processors,
			NotificationProcessedEventRepository notificationProcessedEventRepository) {

		this.processors = processors;
		this.notificationProcessedEventRepository = notificationProcessedEventRepository;
	}

	public static NotificationResponse process(OrderCreatedEvent event) {
		String eventId = event.getEventId();
		// 1. Check whether event was already processed
		if (NotificationProcessedEventRepository.existsById(eventId)) {
			System.out.println("Duplicate event received: " + eventId);
			return null;
		}

		// 2. Find appropriate payment processor
		PaymentProcessor processor = processors.stream().filter(p -> p.supports(event.getPaymentMethod())).findFirst()
				.orElseThrow(
						() -> new IllegalArgumentException("Unsupported payment method: " + event.getPaymentMethod()));

		// 3. Process payment
		PaymentResponse response = processor.processPayment(event);

		// 4. Mark event as processed only after successful processing
		paymentProcessedEventRepository.save(new PaymentProcessEvent(eventId));

		if (response.getStatus().equalsIgnoreCase("SUCCESS")) {
			PaymentCreatedEvent paymentCreatedEvent = new PaymentCreatedEvent();

		}
	}

}
