package com.titan.payment.service;

import java.util.List;

import org.springframework.stereotype.Service;

import com.titan.payment.entity.OrderCreatedEntity;
import com.titan.payment.processor.PaymentProcessor;
import com.titan.payment.repository.PaymentProcessedEventRepository;
import com.titan.payment.response.PaymentResponse;

@Service
public class PaymentService {
	private final List<PaymentProcessor> processors;
    private final PaymentProcessedEventRepository paymentProcessedEventRepository;

    public PaymentService(
            List<PaymentProcessor> processors,
            PaymentProcessedEventRepository paymentProcessedEventRepository) {

        this.processors = processors;
        this.paymentProcessedEventRepository = paymentProcessedEventRepository;
    }

	public PaymentResponse process(OrderCreatedEntity event) {

		PaymentProcessor processor = processors.stream().filter(p -> p.supports(event.getPaymentMethod())).findFirst()
				.orElseThrow(() -> new IllegalArgumentException("Unsupported payment method: " + event.getPaymentMethod()));

		return processor.processPayment(event);
	}
}
