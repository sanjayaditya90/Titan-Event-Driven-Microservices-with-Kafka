package com.titan.payment.processor;

import com.titan.payment.entity.OrderCreatedEntity;
import com.titan.payment.response.PaymentResponse;

public class UpiPaymentProcessor implements PaymentProcessor {

	@Override
	public PaymentResponse processPayment(OrderCreatedEntity event) {
		if (event.getAmount() <= 0) {
			throw new RuntimeException("Invalid payment amount");
		}
		System.out.println("Processing UPI payment for order: " + event.getOrderNo());
		return new PaymentResponse(event.getOrderNo(), "SUCCESS");
	}

	@Override
	public boolean supports(String paymentMethod) {
		return "UPI".equalsIgnoreCase(paymentMethod);
	}

}
